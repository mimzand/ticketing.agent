{
  "name": "@ticket/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agent service: serves @ticket/agent-protocol on 127.0.0.1 and writes the state file. Runs without Electron.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "adk:web": "tsx src/adk-web.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ticket/adk-runtime": "workspace:*",
    "@ticket/agent-host": "workspace:*",
    "@ticket/agent-protocol": "workspace:*",
    "@ticket/model-provider": "workspace:*",
    "@ticket/shared": "workspace:*",
    "@ticket/storage": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@google/adk-devtools": "2.4.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.15"
  }
}
