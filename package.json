{
  "name": "redrock-ticketing-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Windows desktop app that assigns one organization department to an incoming ticket.",
  "type": "module",
  "packageManager": "yarn@4.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent:dev": "yarn workspace @ticket/agent run dev",
    "api:dev": "yarn workspace @ticket/api run dev",
    "api:up": "yarn workspaces foreach --all --parallel --jobs unlimited --interlaced --verbose --include @ticket/agent --include @ticket/api run dev",
    "dev": "yarn workspace @ticket/desktop run dev",
    "typecheck": "tsc -p tsconfig.json && yarn workspaces foreach --all --exclude redrock-ticketing-agent --verbose run typecheck",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "eval": "yarn workspace @ticket/eval run eval"
  },
  "dependenciesMeta": {
    "@scarf/scarf": {
      "built": false
    },
    "better-sqlite3": {
      "built": false
    },
    "electron": {
      "built": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.1"
  }
}
